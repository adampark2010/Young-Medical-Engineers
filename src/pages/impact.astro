---
/**
 * Impact. No counters, no figures. The approved substitute paragraph is the
 * whole page until the team supplies real numbers.
 */
import Page from '../layouts/Page.astro';
import { impact, meta } from '../content/copy';
---

<Page title="Impact" description={meta.impact} eyebrow={impact.eyebrow} heading={impact.heading}>
  <div class="container">
    <section class="section grid">
      <div class="c3-10">
        <hr class="accent-rule" aria-hidden="true" />
        <p class="statement">{impact.paragraph}</p>
      </div>
    </section>
  </div>
</Page>

<style>
  .accent-rule {
    width: 3rem;
    border: 0;
    border-top: 2px solid var(--accent);
    margin: 0.5rem 0 1.75rem;
  }

  .statement {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.2rem + 0.9vw, 1.75rem);
    line-height: 1.35;
    max-width: 30em;
  }
</style>
