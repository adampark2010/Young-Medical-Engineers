---
/**
 * Footer. The single-line wordmark (logo-word) appears here and nowhere else
 * on inner pages, bookending the serif name in the masthead. It is held at
 * 22px tall on desktop and 18px on small screens, never scaled by the grid.
 */
import { Image } from 'astro:assets';
import wordmark from '../brand/originals/logo-word.png';
import { nav } from '../content/nav';
import { SITE } from '../config';
import InstagramIcon from './InstagramIcon.astro';
---

<footer class="footer">
  <div class="container">
    <hr class="rule" />
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="wordmark-link">
          <Image
            src={wordmark}
            alt={SITE.name}
            width={249}
            height={22}
            densities={[1, 2, 3]}
            loading="lazy"
            class="wordmark"
          />
        </a>
      </div>
      <nav class="footer-nav" aria-label="Site, footer">
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div class="footer-contact">
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p>
          <a class="ig" href={SITE.instagramUrl} rel="noopener" target="_blank">
            <InstagramIcon />
            <span>{SITE.instagramHandle}</span>
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding-bottom: 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 249px minmax(0, 1fr) minmax(0, 1fr);
    column-gap: calc(var(--gutter) * 2);
    row-gap: 1.5rem;
    padding-block: 2rem 1.5rem;
  }

  .wordmark-link {
    display: inline-block;
  }

  .wordmark {
    width: 249px;
    height: 22px;
  }

  .footer-nav ul {
    columns: 2;
    column-gap: var(--gutter);
  }

  .footer-nav a,
  .footer-contact a {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .footer-nav a {
    display: inline-block;
    padding-block: 0.125rem;
    color: var(--ink);
    text-decoration: none;
  }

  .footer-nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent-warm);
  }

  .footer-contact p + p {
    margin-top: 0.25rem;
  }

  .ig {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  @media (max-width: 900px) {
    .footer {
      margin-top: 3rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }

    .wordmark {
      width: 204px; /* 18px tall */
      height: 18px;
    }
  }
</style>
