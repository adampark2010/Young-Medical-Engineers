---
/**
 * Footer. The single-line wordmark (logo-word) appears here and nowhere else
 * on inner pages, bookending the serif name in the masthead.
 */
import { Image } from 'astro:assets';
import wordmark from '../brand/originals/logo-word.png';
import { nav } from '../content/nav';
import { splash } from '../content/copy';
import { SITE } from '../config';
import InstagramIcon from './InstagramIcon.astro';
---

<footer class="footer">
  <div class="container">
    <hr class="rule" />
    <div class="footer-grid grid">
      <div class="footer-brand c1-2">
        <a href="/" class="wordmark-link">
          <Image
            src={wordmark}
            alt={SITE.name}
            width={249}
            height={22}
            densities={[1, 2, 3]}
            loading="lazy"
            class="wordmark"
          />
        </a>
      </div>
      <nav class="footer-nav c3-8" aria-label="Site, footer">
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div class="footer-contact c8-12">
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p>
          <a class="ig" href={SITE.instagramUrl} rel="noopener" target="_blank">
            <InstagramIcon />
            <span>{SITE.instagramHandle}</span>
          </a>
        </p>
      </div>
    </div>
    <p class="colophon meta">{splash.topStrip}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding-bottom: 2.5rem;
  }

  .footer-grid {
    padding-block: 2rem 1.5rem;
    row-gap: 1.5rem;
  }

  .footer-brand {
    grid-column: 1 / 3;
    min-width: 0;
  }

  .wordmark-link {
    display: inline-block;
  }

  .wordmark {
    width: 249px;
    max-width: 100%;
    height: auto;
  }

  .footer-nav ul {
    columns: 2;
    column-gap: var(--gutter);
  }

  .footer-nav a,
  .footer-contact a {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .footer-nav a {
    display: inline-block;
    padding-block: 0.125rem;
    color: var(--ink);
    text-decoration: none;
  }

  .footer-nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent-warm);
  }

  .footer-contact p + p {
    margin-top: 0.25rem;
  }

  .ig {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .colophon {
    padding-top: 1rem;
    border-top: 1px solid var(--divider);
  }

  @media (max-width: 900px) {
    .footer {
      margin-top: 3rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .wordmark {
      width: 204px; /* 18px tall on mobile */
    }
  }

  @media (min-width: 901px) {
    /* The wordmark needs more than the two margin columns; let it overflow
       into the gutter rather than shrink. */
    .footer-brand {
      grid-column: 1 / 4;
    }
    .footer-nav {
      grid-column: 4 / 8;
    }
  }
</style>
