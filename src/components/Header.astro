---
/**
 * Masthead. One lockup on every inner page: the emblem (logo-mark) at a fixed
 * height beside the typeset name, held at the container's left margin so the
 * mark shares a vertical axis with every page title beneath it.
 *
 * The nine-item nav needs about 1180px alongside the lockup, so the menu
 * collapses below that; the compact 56px masthead applies below 900px.
 */
import { Image } from 'astro:assets';
import mark from '../brand/originals/logo-mark.png';
import { nav } from '../content/nav';
import { shared } from '../content/copy';
import { SITE } from '../config';

const current = Astro.url.pathname;
---

<header class="masthead">
  <div class="container masthead-inner">
    <a class="brand" href="/">
      <Image
        src={mark}
        alt=""
        width={74}
        height={36}
        densities={[1, 2, 3]}
        loading="eager"
        decoding="sync"
        class="brand-mark"
      />
      <span class="brand-name">{SITE.name}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-label-open={shared.close}
      data-label-closed={shared.menu}
    >
      <span class="nav-toggle-icon" aria-hidden="true"></span>
      <span class="nav-toggle-label" data-nav-label>{shared.menu}</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Site">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--hairline);
    background: var(--paper);
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 18px; /* half the emblem height */
    padding-block: 18px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-mark {
    width: 74px;
    height: 36px;
    flex: none;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.375rem; /* 22px, cap height close to the emblem's letters */
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    padding-top: 2px; /* optical alignment to the emblem's centre */
  }

  .site-nav ul {
    display: flex;
    gap: 1.5rem;
  }

  .site-nav a {
    display: inline-block;
    padding-block: 0.375rem;
    font-weight: 500;
    font-size: 0.9375rem; /* 15px */
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .site-nav a:hover {
    border-bottom-color: var(--accent-warm);
  }

  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--accent);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    padding: 0 0.25rem;
    background: none;
    border: 0;
    cursor: pointer;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  /* Two 1.5px strokes: the one purely functional icon in the masthead. */
  .nav-toggle-icon {
    position: relative;
    width: 22px;
    height: 12px;
  }

  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
    width: 22px;
    height: 1.5px;
    background: var(--border-strong);
    transition: transform var(--fade);
  }

  .nav-toggle-icon::before {
    top: 0;
  }

  .nav-toggle-icon::after {
    bottom: 0;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-icon::before {
    transform: translateY(5.25px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-icon::after {
    transform: translateY(-5.25px) rotate(-45deg);
  }

  /* Collapsed navigation (menu panel) below 1180px. */
  @media (max-width: 1180px) {
    :global(html.js) .nav-toggle {
      display: inline-flex;
    }

    :global(html.js) .site-nav {
      display: none;
      position: fixed;
      inset: 73px 0 0 0;
      z-index: 50;
      background: var(--paper);
      overflow-y: auto;
      padding: 1.5rem var(--margin) 3rem;
    }

    :global(html.js) .site-nav[data-open] {
      display: block;
    }

    :global(html.no-js) .site-nav {
      width: 100%;
      order: 3;
      padding-bottom: 0.75rem;
    }

    :global(html.no-js) .masthead-inner {
      flex-wrap: wrap;
    }

    :global(html.no-js) .site-nav ul {
      flex-wrap: wrap;
      gap: 0.25rem 1.5rem;
    }

    :global(html.js) .site-nav ul {
      flex-direction: column;
      gap: 0;
      max-width: var(--container);
      margin-inline: auto;
    }

    :global(html.js) .site-nav li + li {
      border-top: 1px solid var(--hairline);
    }

    :global(html.js) .site-nav a {
      display: block;
      padding-block: 0.875rem;
      font-family: var(--font-serif);
      font-weight: 500;
      font-size: 2rem;
      line-height: 1.1;
      border-bottom: 0;
      border-left: 2px solid transparent;
      padding-left: 0.75rem;
      margin-left: -0.75rem;
      white-space: normal;
    }

    :global(html.js) .site-nav a[aria-current='page'] {
      border-left-color: var(--accent);
    }
  }

  /* Compact masthead on small screens. */
  @media (max-width: 900px) {
    .masthead-inner {
      min-height: 56px;
      gap: 1rem;
    }

    .brand {
      gap: 14px;
      padding-block: 14px;
    }

    .brand-mark {
      width: 58px;
      height: 28px;
    }

    .brand-name {
      font-size: 1.125rem;
    }

    :global(html.js) .site-nav {
      inset: 57px 0 0 0;
    }
  }

  @media (max-width: 380px) {
    .brand-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  const label = toggle?.querySelector<HTMLElement>('[data-nav-label]');
  // Everything outside the masthead is made inert while the panel is open, so
  // focus and screen readers stay inside the menu.
  const outside = Array.from(document.querySelectorAll<HTMLElement>('main, footer'));

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? toggle.dataset.labelOpen || '' : toggle.dataset.labelClosed || '';
      if (open) nav.setAttribute('data-open', '');
      else nav.removeAttribute('data-open');
      document.body.style.overflow = open ? 'hidden' : '';
      for (const el of outside) el.toggleAttribute('inert', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 1181px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
