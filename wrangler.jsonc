{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yme-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // node:crypto and Buffer, used by lib/auth.js and lib/http.js
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // keep the .html addresses the pages link to, the sitemap lists and GitHub Pages used
    "html_handling": "none",
    // only these reach worker.js; every other request is served straight from public/
    "run_worker_first": ["/", "/api/*", "/admin", "/admin/"]
  },
  "observability": { "enabled": true }
}
